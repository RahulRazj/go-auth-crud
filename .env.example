# Example environment variables for go-auth-crud
# Copy this to .env and update values for your local environment.

GO_AUTH_CRUD_PRIMARY.ENV=development
GO_AUTH_CRUD_LOGGING.LEVEL=debug
GO_AUTH_CRUD_LOGGING.FILE=logs/app.log

GO_AUTH_CRUD_SERVER.PORT=8080
GO_AUTH_CRUD_SERVER.READ_TIMEOUT=30
GO_AUTH_CRUD_SERVER.WRITE_TIMEOUT=30
GO_AUTH_CRUD_SERVER.IDLE_TIMEOUT=60
# Comma-separated CORS origins
GO_AUTH_CRUD_SERVER.CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5600

GO_AUTH_CRUD_DATABASE.HOST=localhost
GO_AUTH_CRUD_DATABASE.PORT=5432
GO_AUTH_CRUD_DATABASE.USER=postgres
GO_AUTH_CRUD_DATABASE.PASSWORD=
GO_AUTH_CRUD_DATABASE.NAME=GO_AUTH_CRUD
GO_AUTH_CRUD_DATABASE.SSL_MODE=disable
GO_AUTH_CRUD_DATABASE.MAX_OPEN_CONNS=25
GO_AUTH_CRUD_DATABASE.MAX_IDLE_CONNS=25
GO_AUTH_CRUD_DATABASE.CONN_MAX_LIFETIME=300
GO_AUTH_CRUD_DATABASE.CONN_MAX_IDLE_TIME=300
